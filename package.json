{
  "name": "pi-antigravity-native",
  "version": "1.2.0",
  "description": "Google Antigravity Native Provider Extension for Pi CLI with Gemini 3.8, prompt cache session affinity, and trajectory chaining",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "pi",
    "pi-extension",
    "pi-package",
    "antigravity",
    "gemini",
    "google-cloud-code-assist",
    "oauth",
    "prompt-caching"
  ],
  "author": "Minh GV <minhgv@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "undici": "^8.10.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.70.0",
    "@mariozechner/pi-coding-agent": ">=0.73.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^22.20.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
